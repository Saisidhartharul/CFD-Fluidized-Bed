# ---------------------------------------------------------------
# Solver RESULTS - never commit. Regenerated by running the case.
# NOTE: leading **/ is required, or these only match at repo root.
# ---------------------------------------------------------------
**/*.rocky.files/simulation/
**/*.rocky.files/tmp/
**/*.rhs
**/*.rhf
**/*.lock
**/*.trn
cleanup-fluent-*.bat
fluent-*-error.log

# dead backup copies from Stage 1 debugging
*.bak-*
*.patched-didnotwork

# Ansys tutorial material (vendor-supplied, not our work)
mesh/dem_tut14_files/
mesh/dem_tut14_files.zip
docs/Rocky_Tutorial_Guide.pdf

# duplicate of docs/CFD_SS2026_Project_Update_FBR.pdf
/CFD_SS2026_Project_Update_FBR.pdf

# OpenFOAM legacy (earlier attempt)
processor*/
postProcessing/
logs/

# Generic large result formats
*.vtk
*.vtu
*.foam
*.dat
*.h5
*.log

# ---------------------------------------------------------------
# ...but these INPUTS are required to reproduce a run and MUST be
# tracked, so re-include them after the blanket rules above.
# ---------------------------------------------------------------
!fbr_*.cas.h5
!*.restart
!*.rcy
!*.msh

# Read-back logs: the record of what was actually applied
!bed_measurements.txt
!build_*.txt
!setup_*.txt

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
